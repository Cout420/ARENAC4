{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile that includes WhatsApp and CPF required for booking",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "cpf": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "isBlocked": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "whatsapp", "cpf", "role", "isBlocked", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A field booking made by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sport": { "type": "string", "enum": ["society", "areia"] },
        "dateId": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "wo"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sport", "dateId", "time", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Bookings for the arena"
    }
  }
}
